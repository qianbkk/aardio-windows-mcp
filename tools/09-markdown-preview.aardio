//===================================================================
// 工具09: Markdown 实时预览
// 功能: 双栏,左编辑右预览,支持代码高亮,GFM
//===================================================================

import win.ui;
import web.view;

/*DSG{{*/
var winform = win.form(text="Markdown 预览";right=1000;bottom=700;border="thin")
winform.add(
edt={cls="edit";text="# Hello Markdown\n\n## aardio 简介\n\n**aardio** 是一款 22 年历史的 Windows 桌面开发工具,极小(6.5MB),能生成独立 EXE。\n\n## 功能\n\n- 极小体积\n- 永久免费\n- AI 集成\n- 完美 Windows 兼容\n\n## 代码\n\nimport win.ui;\nvar winform = win.form(text=Hello);\nwinform.add(button={cls=button;text=点我});\nwinform.show();\nwin.loopMessage();\n\n## 表格\n\n| 工具 | 体积 |\n|------|------|\n| aardio | 6.5 MB |\n| Electron | 100 MB |\n| PyQt | 30 MB |\n\n## 引用\n\n> 22 年还在更新,这才是真正的好工具。\n\n## 链接\n\n[官网](https://aardio.com)\n\n## 任务\n\n- [x] 学会 aardio\n- [ ] 做 20 个工具\n- [ ] 发布到 GitHub";left=10;top=10;right=490;bottom=680;edge=1;hscroll=1;multiline=1;vscroll=1;font=LOGFONT(h=-13);z=1};
wb={cls="custom";left=500;top=10;right=990;bottom=680;z=2}
)
/*}}*/

var web = web.view(winform.wb);

// Markdown 渲染: text.markdown 是不存在的扩展库, 这里用内置迷你渲染器 (标准库 string 实现)
// 支持: 标题/粗体/斜体/行内代码/代码块/列表/链接/表格/引用/任务列表
var escapeHtml = function(s){
    return string.replace(s, `[<>"&]`, function(c){
        if(c == "<") return "&lt;";
        if(c == ">") return "&gt;";
        if(c == `"`) return "&quot;";
        return "&amp;";
    });
}

var inlineMd = function(s){
    s = escapeHtml(s);
    s = string.replace(s, "`([^`]+)`", function(m){ return "<code>" ++ m ++ "</code>"; });
    s = string.replace(s, "%*%*([^%*]+)%*%*", function(m){ return "<strong>" ++ m ++ "</strong>"; });
    s = string.replace(s, "%*([^%*]+)%*", function(m){ return "<em>" ++ m ++ "</em>"; });
    s = string.replace(s, "%[([^%]]+)%]%(([^%)]+)%)", function(t, u){ return "<a href='" ++ u ++ "'>" ++ t ++ "</a>"; });
    return s;
}

var mdToHtml = function(md){
    var html = {};
    var inCode = false;
    var codeBuf = {};
    for line in string.lines(md){
        var trimmed = string.trim(line);
        if(string.startWith(trimmed, "```")){
            if(inCode){
                table.push(html, "<pre><code>" ++ table.concat(codeBuf, "\n") ++ "</code></pre>");
                codeBuf = {};
            }
            inCode = !inCode;
            continue;
        }
        if(inCode){
            table.push(codeBuf, escapeHtml(line));
            continue;
        }
        if(#trimmed == 0){ continue; }
        if(string.startWith(trimmed, "###")){
            table.push(html, "<h3>" ++ inlineMd(string.trim(string.slice(trimmed, 4))) ++ "</h3>");
        } else if(string.startWith(trimmed, "##")){
            table.push(html, "<h2>" ++ inlineMd(string.trim(string.slice(trimmed, 3))) ++ "</h2>");
        } else if(string.startWith(trimmed, "#")){
            table.push(html, "<h1>" ++ inlineMd(string.trim(string.slice(trimmed, 2))) ++ "</h1>");
        } else if(string.startWith(trimmed, ">")){
            table.push(html, "<blockquote>" ++ inlineMd(string.trim(string.slice(trimmed, 2))) ++ "</blockquote>");
        } else if(string.startWith(trimmed, "- [x]")){
            table.push(html, "<li><input type='checkbox' checked disabled> " ++ inlineMd(string.trim(string.slice(trimmed, 6))) ++ "</li>");
        } else if(string.startWith(trimmed, "- [ ]")){
            table.push(html, "<li><input type='checkbox' disabled> " ++ inlineMd(string.trim(string.slice(trimmed, 6))) ++ "</li>");
        } else if(string.startWith(trimmed, "-") || string.startWith(trimmed, "*")){
            table.push(html, "<li>" ++ inlineMd(string.trim(string.slice(trimmed, 2))) ++ "</li>");
        } else if(string.match(trimmed, "^%d+%.")){
            table.push(html, "<li>" ++ inlineMd(string.trim(string.replace(trimmed, "^%d+%.", ""))) ++ "</li>");
        } else if(string.startWith(trimmed, "|") && string.find(trimmed, "|")){
            // 表格行
            if(string.find(trimmed, "---")) continue;  // 分隔行
            var cells = string.split(string.trim(trimmed, "|"), "|");
            var row = {};
            for(i, c in cells){
                table.push(row, "<td>" ++ inlineMd(string.trim(c)) ++ "</td>");
            }
            table.push(html, "<tr>" ++ table.concat(row) ++ "</tr>");
        } else if(string.match(trimmed, "^[-=]{3,}$")){
            table.push(html, "<hr>");
        } else {
            table.push(html, "<p>" ++ inlineMd(trimmed) ++ "</p>");
        }
    }
    if(inCode && #codeBuf > 0){
        table.push(html, "<pre><code>" ++ table.concat(codeBuf, "\n") ++ "</code></pre>");
    }
    return table.concat(html, "\n");
}

var renderHtml = function(){
    try{
        var md = winform.edt.text;
        var html = mdToHtml(md);
        // 包裹在 HTML 页面里
        var page = /******
<!DOCTYPE html>
<html><head>
<meta charset="UTF-8">
<style>
body {
    font-family: -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
    max-width: 800px;
    margin: 30px auto;
    padding: 0 20px;
    line-height: 1.6;
    color: #333;
}
h1, h2, h3 { border-bottom: 1px solid #eee; padding-bottom: 8px; }
h1 { font-size: 2em; color: #222; }
h2 { font-size: 1.5em; color: #333; }
h3 { font-size: 1.25em; color: #444; }
code {
    background: #f4f4f4;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: Consolas, Monaco, monospace;
    font-size: 0.9em;
}
pre {
    background: #f8f8f8;
    border: 1px solid #e1e1e1;
    border-radius: 4px;
    padding: 12px;
    overflow-x: auto;
}
pre code {
    background: transparent;
    padding: 0;
}
table {
    border-collapse: collapse;
    width: 100%;
    margin: 16px 0;
}
th, td {
    border: 1px solid #ddd;
    padding: 8px 12px;
    text-align: left;
}
th { background: #f5f5f5; }
blockquote {
    border-left: 4px solid #ddd;
    margin: 16px 0;
    padding: 0 16px;
    color: #666;
    background: #f9f9f9;
}
a { color: #1A73E8; text-decoration: none; }
a:hover { text-decoration: underline; }
input[type=checkbox] { margin-right: 6px; }
ul, ol { padding-left: 28px; }
li { margin: 4px 0; }
</style>
</head>
<body>
******/
        page = page ++ html ++ /******
</body>
</html>
******/
        web.html = page;
    } catch(e){
        web.html = "<pre style='color:red'>" ++ tostring(e) ++ "</pre>";
    }
}

var timer = null;
winform.edt.onChange = function(){
    // 防抖: 200ms 内不重复渲染
    if(timer) winform.clearInterval(timer);
    timer = winform.setInterval(200, function(){
        if(timer){
            winform.clearInterval(timer);
            timer = null;
        }
        renderHtml();
    });
}

renderHtml();
winform.show();
win.loopMessage();
