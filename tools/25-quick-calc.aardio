//===================================================================
// 工具25: 高级计算器
// 功能: 科学计算/单位换算/汇率/编程计算
//===================================================================

import win.ui;
import web.view;

var main = win.form(text="高级计算器";right=600;bottom=500;border="thin")
main.add(
toolbar={cls="bk";left=0;top=0;right=600;bottom=35;bgcolor=0xF0F0F0;z=1};
cmbMode={cls="combobox";text="";left=10;top=8;right=200;bottom=30;edge=1;items={"科学计算器";"单位换算";"汇率换算";"编程计算";"日期计算"};z=2};

edt={cls="edit";text="";left=10;top=45;right=590;bottom=100;edge=1;font=LOGFONT(h=-20);z=3};
content={cls="custom";left=10;top=105;right=590;bottom=490;z=4}
)

var web = web.view(main.content);

// 各模式 HTML
var pages = {};

// 科学计算器
pages["科学计算器"] = /******
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
body { font-family: -apple-system, sans-serif; margin: 0; padding: 16px; background: #f5f5f5; }
.calc { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
.display { background: #2c3e50; color: #fff; padding: 16px; border-radius: 4px; font-size: 28px; text-align: right; margin-bottom: 16px; min-height: 40px; word-break: break-all; }
.keys { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
button { padding: 14px; font-size: 16px; background: #ecf0f1; border: none; border-radius: 4px; cursor: pointer; }
button:hover { background: #d5dbdb; }
button.op { background: #3498db; color: white; }
button.op:hover { background: #2980b9; }
button.eq { background: #27ae60; color: white; grid-column: span 2; }
button.eq:hover { background: #229954; }
button.clr { background: #e74c3c; color: white; }
button.clr:hover { background: #c0392b; }
</style>
</head><body>
<div class="calc">
  <div class="display" id="display">0</div>
  <div class="keys">
    <button class="clr" onclick="clr()">C</button>
    <button class="clr" onclick="back()">⌫</button>
    <button class="op" onclick="add('(')">(</button>
    <button class="op" onclick="add(')')">)</button>
    <button class="op" onclick="add('/')">/</button>
    <button onclick="add('7')">7</button>
    <button onclick="add('8')">8</button>
    <button onclick="add('9')">9</button>
    <button class="op" onclick="add('*')">×</button>
    <button class="op" onclick="add('Math.pow(')">x^y</button>
    <button onclick="add('4')">4</button>
    <button onclick="add('5')">5</button>
    <button onclick="add('6')">6</button>
    <button class="op" onclick="add('-')">-</button>
    <button class="op" onclick="add('Math.sqrt(')">√</button>
    <button onclick="add('1')">1</button>
    <button onclick="add('2')">2</button>
    <button onclick="add('3')">3</button>
    <button class="op" onclick="add('+')">+</button>
    <button class="op" onclick="add('Math.sin(')">sin</button>
    <button onclick="add('0')">0</button>
    <button onclick="add('.')">.</button>
    <button class="op" onclick="add('Math.cos(')">cos</button>
    <button class="op" onclick="add('Math.tan(')">tan</button>
    <button class="op" onclick="add('Math.log(')">ln</button>
    <button class="op" onclick="add('Math.PI')">π</button>
    <button class="op" onclick="add('Math.E')">e</button>
    <button class="op" onclick="add('Math.random()')">rand</button>
    <button class="eq" onclick="eq()">=</button>
  </div>
</div>
<script>
let display = document.getElementById('display');
let expr = '';
function add(c) { expr += c; display.textContent = expr; }
function clr() { expr = ''; display.textContent = '0'; }
function back() { expr = expr.slice(0, -1); display.textContent = expr || '0'; }
function eq() {
    try {
        let r = eval(expr);
        if (typeof r === 'number' && !isFinite(r)) r = '错误';
        display.textContent = r;
        expr = String(r);
    } catch(e) { display.textContent = '错误'; }
}
</script>
</body></html>
******/

// 单位换算
pages["单位换算"] = /******
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
body { font-family: sans-serif; margin: 0; padding: 16px; background: #f5f5f5; }
.card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 12px; }
h3 { margin-top: 0; color: #333; }
.row { display: flex; gap: 8px; align-items: center; margin: 8px 0; }
input, select { padding: 8px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; }
input { flex: 1; }
.result { background: #e8f5e9; padding: 12px; border-radius: 4px; margin-top: 8px; font-size: 16px; color: #2e7d32; }
</style>
</head><body>
<div class="card">
  <h3>📏 长度</h3>
  <div class="row">
    <input id="l-v" value="1" oninput="convLen()">
    <select id="l-f" onchange="convLen()">
      <option value="m">米</option><option value="km">千米</option><option value="cm">厘米</option>
      <option value="mm">毫米</option><option value="in">英寸</option>
      <option value="ft">英尺</option><option value="yd">码</option><option value="mi">英里</option>
    </select>
    <span>→</span>
    <input id="l-r" readonly>
    <select id="l-t" onchange="convLen()">
      <option value="m">米</option><option value="km">千米</option><option value="cm">厘米</option>
      <option value="mm">毫米</option><option value="in">英寸</option>
      <option value="ft">英尺</option><option value="yd">码</option><option value="mi">英里</option>
    </select>
  </div>
</div>
<div class="card">
  <h3>⚖️ 重量</h3>
  <div class="row">
    <input id="w-v" value="1" oninput="convW()">
    <select id="w-f" onchange="convW()">
      <option value="kg">千克</option><option value="g">克</option>
      <option value="t">吨</option><option value="lb">磅</option><option value="oz">盎司</option>
    </select>
    <span>→</span>
    <input id="w-r" readonly>
    <select id="w-t" onchange="convW()">
      <option value="kg">千克</option><option value="g">克</option>
      <option value="t">吨</option><option value="lb">磅</option><option value="oz">盎司</option>
    </select>
  </div>
</div>
<div class="card">
  <h3>🌡️ 温度</h3>
  <div class="row">
    <input id="t-v" value="0" oninput="convT()">
    <select id="t-f" onchange="convT()">
      <option value="C">摄氏度</option><option value="F">华氏度</option><option value="K">开尔文</option>
    </select>
    <span>→</span>
    <input id="t-r" readonly>
    <select id="t-t" onchange="convT()">
      <option value="C">摄氏度</option><option value="F">华氏度</option><option value="K">开尔文</option>
    </select>
  </div>
</div>
<div class="card">
  <h3>💾 数据</h3>
  <div class="row">
    <input id="d-v" value="1" oninput="convD()">
    <select id="d-f" onchange="convD()">
      <option value="B">B</option><option value="KB">KB</option>
      <option value="MB">MB</option><option value="GB">GB</option>
      <option value="TB">TB</option><option value="PB">PB</option>
    </select>
    <span>→</span>
    <input id="d-r" readonly>
    <select id="d-t" onchange="convD()">
      <option value="B">B</option><option value="KB">KB</option>
      <option value="MB">MB</option><option value="GB">GB</option>
      <option value="TB">TB</option><option value="PB">PB</option>
    </select>
  </div>
</div>
<script>
const length = {m:1, km:1000, cm:0.01, mm:0.001, in:0.0254, ft:0.3048, yd:0.9144, mi:1609.344};
function convLen() {
  const v = parseFloat(document.getElementById('l-v').value) || 0;
  const f = document.getElementById('l-f').value;
  const t = document.getElementById('l-t').value;
  document.getElementById('l-r').value = (v * length[f] / length[t]).toFixed(6);
}
const weight = {kg:1, g:0.001, t:1000, lb:0.453592, oz:0.0283495};
function convW() {
  const v = parseFloat(document.getElementById('w-v').value) || 0;
  const f = document.getElementById('w-f').value;
  const t = document.getElementById('w-t').value;
  document.getElementById('w-r').value = (v * weight[f] / weight[t]).toFixed(6);
}
function convT() {
  const v = parseFloat(document.getElementById('t-v').value) || 0;
  const f = document.getElementById('t-f').value;
  const t = document.getElementById('t-t').value;
  let k = f === 'C' ? v + 273.15 : (f === 'F' ? (v - 32) * 5/9 + 273.15 : v);
  let r = t === 'C' ? k - 273.15 : (t === 'F' ? (k - 273.15) * 9/5 + 32 : k);
  document.getElementById('t-r').value = r.toFixed(2);
}
const data = {B:1, KB:1024, MB:1024**2, GB:1024**3, TB:1024**4, PB:1024**5};
function convD() {
  const v = parseFloat(document.getElementById('d-v').value) || 0;
  const f = document.getElementById('d-f').value;
  const t = document.getElementById('d-t').value;
  document.getElementById('d-r').value = (v * data[f] / data[t]).toFixed(6);
}
</script>
</body></html>
******/

// 编程计算
pages["编程计算"] = /******
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
body { font-family: sans-serif; margin: 0; padding: 16px; background: #f5f5f5; }
.card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 12px; }
input, select { padding: 8px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; }
button { padding: 8px 16px; background: #1A73E8; color: white; border: none; border-radius: 4px; cursor: pointer; }
.result { background: #f5f5f5; padding: 12px; border-radius: 4px; margin-top: 8px; font-family: monospace; }
</style>
</head><body>
<div class="card">
  <h3>🔢 进制转换</h3>
  <div style="display:flex;gap:8px;align-items:center;">
    <input id="num" value="255" style="flex:1" oninput="convBase()">
    <select id="from" onchange="convBase()">
      <option value="2">二进制</option>
      <option value="8">八进制</option>
      <option value="10" selected>十进制</option>
      <option value="16">十六进制</option>
    </select>
  </div>
  <div class="result" id="baseResult"></div>
</div>
<div class="card">
  <h3>🔤 字符串</h3>
  <input id="str" value="Hello World" style="width:100%;box-sizing:border-box;" oninput="convStr()">
  <div class="result" id="strResult"></div>
</div>
<div class="card">
  <h3>🎨 颜色</h3>
  <input id="color" value="#1A73E8" style="width:100%;box-sizing:border-box;" oninput="convColor()">
  <div class="result" id="colorResult" style="display:flex;align-items:center;gap:12px;">
    <div id="colorBox" style="width:60px;height:30px;background:#1A73E8;border-radius:4px;"></div>
    <span id="colorText"></span>
  </div>
</div>
<div class="card">
  <h3>⏰ Unix 时间戳</h3>
  <div style="display:flex;gap:8px;align-items:center;">
    <input id="ts" value="1691740800" style="flex:1" oninput="convTs()">
    <button onclick="nowTs()">当前</button>
  </div>
  <div class="result" id="tsResult"></div>
</div>
<script>
function convBase() {
    const n = parseInt(document.getElementById('num').value, parseInt(document.getElementById('from').value));
    if (isNaN(n)) { document.getElementById('baseResult').textContent = '请输入有效数字'; return; }
    document.getElementById('baseResult').innerHTML =
        '二进制: ' + n.toString(2) + '<br>' +
        '八进制: ' + n.toString(8) + '<br>' +
        '十进制: ' + n.toString(10) + '<br>' +
        '十六进制: 0x' + n.toString(16).toUpperCase();
}
function convStr() {
    const s = document.getElementById('str').value;
    document.getElementById('strResult').innerHTML =
        '长度: ' + s.length + '<br>' +
        'UTF-8 字节: ' + new Blob([s]).size + '<br>' +
        'UTF-16 字节: ' + s.length * 2 + '<br>' +
        'Base64: ' + btoa(unescape(encodeURIComponent(s))) + '<br>' +
        'URL 编码: ' + encodeURIComponent(s) + '<br>' +
        '反转: ' + s.split('').reverse().join('') + '<br>' +
        '大写: ' + s.toUpperCase() + '<br>' +
        '小写: ' + s.toLowerCase();
}
function convColor() {
    const c = document.getElementById('color').value;
    if (!/^#[0-9A-Fa-f]{6}$/.test(c)) return;
    const r = parseInt(c.slice(1, 3), 16);
    const g = parseInt(c.slice(3, 5), 16);
    const b = parseInt(c.slice(5, 7), 16);
    document.getElementById('colorBox').style.background = c;
    document.getElementById('colorText').innerHTML =
        'HEX: ' + c.toUpperCase() + '<br>' +
        'RGB: rgb(' + r + ', ' + g + ', ' + b + ')<br>' +
        'HSL: ' + rgbToHsl(r, g, b);
}
function rgbToHsl(r, g, b) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h, s, l = (max + min) / 2;
    if (max == min) { h = s = 0; }
    else {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        switch (max) {
            case r: h = (g - b) / d + (g < b ? 6 : 0); break;
            case g: h = (b - r) / d + 2; break;
            case b: h = (r - g) / d + 4; break;
        }
        h /= 6;
    }
    return 'hsl(' + Math.round(h * 360) + ', ' + Math.round(s * 100) + '%, ' + Math.round(l * 100) + '%)';
}
function convTs() {
    const ts = parseInt(document.getElementById('ts').value);
    if (isNaN(ts)) return;
    const d = new Date(ts * 1000);
    document.getElementById('tsResult').textContent =
        'ISO: ' + d.toISOString() + '\n' +
        '本地: ' + d.toLocaleString('zh-CN');
}
function nowTs() {
    document.getElementById('ts').value = Math.floor(Date.now() / 1000);
    convTs();
}
convBase(); convStr(); convColor(); convTs();
</script>
</body></html>
******/

// 简化日期计算 + 汇率
pages["日期计算"] = /******
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
body { font-family: sans-serif; margin: 0; padding: 16px; background: #f5f5f5; }
.card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 12px; }
input, button { padding: 8px; border-radius: 4px; font-size: 14px; }
input { border: 1px solid #ddd; }
button { background: #1A73E8; color: white; border: none; cursor: pointer; }
.result { background: #e8f5e9; padding: 12px; border-radius: 4px; margin-top: 8px; }
</style>
</head><body>
<div class="card">
  <h3>📅 日期间隔</h3>
  <div style="display:flex;gap:8px;align-items:center;">
    <input id="d1" type="date">
    <span>~</span>
    <input id="d2" type="date">
    <button onclick="diff()">计算</button>
  </div>
  <div class="result" id="diffResult"></div>
</div>
<div class="card">
  <h3>➕ 日期加减</h3>
  <div style="display:flex;gap:8px;align-items:center;">
    <input id="d3" type="date">
    <input id="d-num" type="number" value="7" style="width:80px;">
    <select id="d-unit">
      <option>天</option><option>周</option><option>月</option><option>年</option>
    </select>
    <button onclick="addDays()">+</button>
    <button onclick="subDays()">-</button>
  </div>
  <div class="result" id="addResult"></div>
</div>
<div class="card">
  <h3>⏱️ 时间戳</h3>
  <div style="display:flex;gap:8px;align-items:center;">
    <input id="d4" type="datetime-local">
    <button onclick="toTs()">→ 时间戳</button>
  </div>
  <div class="result" id="tsResult2"></div>
</div>
<script>
document.getElementById('d1').value = new Date().toISOString().slice(0, 10);
document.getElementById('d2').value = new Date(Date.now() + 7*86400000).toISOString().slice(0, 10);
document.getElementById('d3').value = new Date().toISOString().slice(0, 10);
document.getElementById('d4').value = new Date().toISOString().slice(0, 16);

function diff() {
    const d1 = new Date(document.getElementById('d1').value);
    const d2 = new Date(document.getElementById('d2').value);
    const days = Math.round((d2 - d1) / 86400000);
    const weeks = Math.floor(days / 7);
    const months = Math.round(days / 30.44);
    const years = (days / 365.25).toFixed(2);
    document.getElementById('diffResult').innerHTML =
        '相差: ' + days + ' 天<br>' +
        '约 ' + weeks + ' 周<br>' +
        '约 ' + months + ' 月<br>' +
        '约 ' + years + ' 年';
}
function addDays() {
    const n = parseInt(document.getElementById('d-num').value);
    const u = document.getElementById('d-unit').value;
    const d = new Date(document.getElementById('d3').value);
    if (u === '天') d.setDate(d.getDate() + n);
    else if (u === '周') d.setDate(d.getDate() + n*7);
    else if (u === '月') d.setMonth(d.getMonth() + n);
    else if (u === '年') d.setFullYear(d.getFullYear() + n);
    document.getElementById('d3').value = d.toISOString().slice(0, 10);
    document.getElementById('addResult').textContent = '结果: ' + d.toISOString().slice(0, 10);
}
function subDays() {
    document.getElementById('d-num').value = -parseInt(document.getElementById('d-num').value);
    addDays();
    document.getElementById('d-num').value = -parseInt(document.getElementById('d-num').value);
}
function toTs() {
    const d = new Date(document.getElementById('d4').value);
    document.getElementById('tsResult2').textContent = 'Unix: ' + Math.floor(d.getTime() / 1000) + ' (' + d.getTime() + ' ms)';
}
diff();
</script>
</body></html>
******/

// 汇率 (用固定参考汇率,真实场景应调 API)
pages["汇率换算"] = /******
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
body { font-family: sans-serif; margin: 0; padding: 16px; background: #f5f5f5; }
.card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 12px; }
.row { display: flex; gap: 8px; align-items: center; }
input, select { padding: 8px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; }
input { flex: 1; }
.note { color: #999; font-size: 12px; margin-top: 8px; }
</style>
</head><body>
<div class="card">
  <h3>💱 汇率换算 (参考汇率)</h3>
  <div class="row">
    <input id="amount" value="100" oninput="convert()">
    <select id="from" onchange="convert()">
      <option value="CNY">CNY 人民币</option>
      <option value="USD">USD 美元</option>
      <option value="EUR">EUR 欧元</option>
      <option value="JPY">JPY 日元</option>
      <option value="GBP">GBP 英镑</option>
      <option value="HKD">HKD 港币</option>
      <option value="KRW">KRW 韩元</option>
    </select>
  </div>
  <div style="text-align:center;margin:12px 0;">↓ 转换为</div>
  <select id="to" style="width:100%;padding:10px;font-size:16px;" onchange="convert()">
    <option value="USD">USD 美元</option>
    <option value="EUR">EUR 欧元</option>
    <option value="JPY">JPY 日元</option>
    <option value="GBP">GBP 英镑</option>
    <option value="HKD">HKD 港币</option>
    <option value="KRW">KRW 韩元</option>
    <option value="CNY">CNY 人民币</option>
  </select>
  <div class="result" id="result" style="background:#e8f5e9;padding:16px;border-radius:4px;margin-top:12px;font-size:24px;text-align:center;color:#2e7d32;"></div>
  <div class="note">⚠️ 汇率仅为参考,实际交易以银行汇率为准。点击"刷新汇率"获取最新数据(需联网)。</div>
  <button onclick="fetchRates()" style="margin-top:8px;background:#1A73E8;color:white;padding:8px 16px;border:none;border-radius:4px;cursor:pointer;">刷新汇率 (联网)</button>
</div>
<script>
let rates = {CNY:1, USD:0.14, EUR:0.13, JPY:20.5, GBP:0.11, HKD:1.1, KRW:186};
function convert() {
    const amount = parseFloat(document.getElementById('amount').value) || 0;
    const from = document.getElementById('from').value;
    const to = document.getElementById('to').value;
    const cnyAmount = amount / rates[from];
    const result = cnyAmount * rates[to];
    document.getElementById('result').textContent = result.toFixed(4) + ' ' + to;
}
async function fetchRates() {
    try {
        const r = await fetch('https://api.exchangerate-api.com/v4/latest/CNY');
        const d = await r.json();
        if (d.rates) {
            rates = d.rates;
            convert();
            document.querySelector('.note').textContent = '✓ 已更新 (' + new Date(d.time_last_updated * 1000).toLocaleString() + ')';
        }
    } catch(e) {
        document.querySelector('.note').textContent = '✗ 获取失败: ' + e.message;
    }
}
convert();
</script>
</body></html>
******/

main.cmbMode.oncommand = function(){
    var mode = main.cmbMode.selText || "科学计算器";
    if(pages[mode]){
        web.html = pages[mode];
    }
};

web.html = pages["科学计算器"];

main.show();
win.loopMessage();
