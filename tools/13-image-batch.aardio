//===================================================================
// 工具13: 批量图片处理
// 功能: 批量缩放/压缩/格式转换/加水印
//===================================================================

import win.ui;
import fsys.dlg;
import gdip;
import process;

var main = win.form(text="批量图片处理";right=600;bottom=500;border="thin")
main.add(
lblSrc={cls="static";text="源目录:";left=10;top=10;right=80;bottom=30;z=1};
edtSrc={cls="edit";text="";left=90;top=5;right=500;bottom=30;edge=1;readonly=1;z=2};
btnSrc={cls="button";text="选择...";left=505;top=5;right=590;bottom=30;z=3};
lblOut={cls="static";text="输出目录:";left=10;top=40;right=80;bottom=60;z=4};
edtOut={cls="edit";text="";left=90;top=35;right=500;bottom=60;edge=1;readonly=1;z=5};
btnOut={cls="button";text="选择...";left=505;top=35;right=590;bottom=60;z=6};
chkResize={cls="checkbox";text="缩放 - 宽度:";left=10;top=75;right=150;bottom=95;checked=1;z=7};
edtWidth={cls="edit";text="1920";left=155;top=70;right=240;bottom=95;edge=1;z=8};
lblX={cls="static";text="px (高度等比)";left=245;top=75;right=400;bottom=95;color=0x999999;z=9};
chkQuality={cls="checkbox";text="压缩质量:";left=10;top=100;right=150;bottom=120;checked=1;z=10};
edtQuality={cls="edit";text="85";left=155;top=95;right=240;bottom=120;edge=1;z=11};
lblQ={cls="static";text="(1-100, 越高质量越好)";left=245;top=100;right=480;bottom=120;color=0x999999;z=12};
chkFormat={cls="checkbox";text="转换格式为:";left=10;top=125;right=150;bottom=145;z=13};
cmbFormat={cls="combobox";text="jpg";left=155;top=120;right=240;bottom=145;edge=1;items={"jpg";"png";"webp";"bmp"};z=14};
chkWatermark={cls="checkbox";text="水印文字:";left=10;top=150;right=150;bottom=170;z=15};
edtWatermark={cls="edit";text="© aardio";left=155;top=145;right=400;bottom=170;edge=1;z=16};
btnStart={cls="button";text="开始处理";left=10;top=200;right=590;bottom=240;font=LOGFONT(h=-14);z=17};
progress={cls="progress";left=10;top=250;right=590;bottom=275;bgcolor=0xEEEEEE;foreColor=0xFF1A73E8;z=18};
log={cls="edit";text="";left=10;top=285;right=590;bottom=485;bgcolor=0x1E1E1E;color=0x00FF00;edge=1;hscroll=1;multiline=1;readonly=1;vscroll=1;z=19}
)

var logMsg = function(s){
    winform.log.appendLog(s ++ "\r\n");
    winform.log.scrollCaret();
}

var supportedExt = {jpg=1; jpeg=1; png=1; bmp=1; webp=1; tiff=1; gif=1};

winform.btnSrc.oncommand = function(){
    var dir = fsys.dlg.dir(, winform.edtSrc.text)
    if(dir) winform.edtSrc.text = dir;
}

winform.btnOut.oncommand = function(){
    var dir = fsys.dlg.dir(, winform.edtOut.text)
    if(dir) winform.edtOut.text = dir;
}

winform.btnStart.oncommand = function(){
    var srcDir = winform.edtSrc.text;
    var outDir = winform.edtOut.text;
    if(#srcDir == 0 || !fsys.isDir(srcDir)){
        main.msgbox("请选择源目录", "提示", 0x40);
        return;
    }
    if(#outDir == 0) outDir = srcDir ++ "\\output";
    if(!fsys.isDir(outDir)) fsys.createDir(outDir);

    var targetWidth = tonumber(winform.edtWidth.text) || 1920;
    var quality = tonumber(winform.edtQuality.text) || 85;
    var targetFormat = winform.cmbFormat.selText || "jpg";
    var watermark = winform.edtWatermark.text;
    var doResize = winform.chkResize.checked;
    var doQuality = winform.chkQuality.checked;
    var doFormat = winform.chkFormat.checked;
    var doWatermark = winform.chkWatermark.checked;

    logMsg("开始处理...");
    logMsg("源目录: " ++ srcDir);
    logMsg("输出目录: " ++ outDir);

    // 收集所有图片 (fsys.list 返回 files, folders 两个数组)
    var files = {};
    var fileList, folderList = fsys.list(srcDir);
    for(i, f in fileList){
        var full = srcDir ++ "\\" ++ f;
        var ext = string.lower(fsys.getExtensionName(f));
        if(supportedExt[ext]){
            table.push(files, full);
        }
    }
    logMsg("找到 " ++ #files ++ " 个图片文件");

    if(#files == 0){
        main.msgbox("没有找到图片文件", "提示", 0x40);
        return;
    }

    winform.progress.setProgress(0, #files);
    var success = 0;
    var failed = 0;

    for(i=1; #files; 1){
        var file = files[i];
        var name = fsys.getFileName(file);
        logMsg("[" ++ i ++ "/" ++ #files ++ "] " ++ name);

        try{
            var bmp = gdip.bitmap(file);
            if(!bmp){
                logMsg("  加载失败");
                failed = failed + 1;
            }
            // aardio 不支持 try 块内 continue, 用 if 包裹后续处理
            if(bmp){
            var w = bmp.width;
            var h = bmp.height;
            logMsg("  原始尺寸: " ++ w ++ " x " ++ h);

            var newW = w, newH = h;
            if(doResize && w > targetWidth){
                newW = targetWidth;
                newH = math.floor(h * targetWidth / w);
            }

            var outBmp = bmp;
            if(newW != w || newH != h){
                outBmp = gdip.bitmap(newW, newH);
                gdip.graphics(outBmp).drawImage(bmp, 0, 0, newW, newH);
            }

            // 水印
            if(doWatermark && #watermark > 0){
                var g = gdip.graphics(outBmp);
                var font = gdip.font("Arial", math.max(16, math.floor(newH / 30)), 0, 0, 0);
                var brush = gdip.solidBrush(0x80FFFFFF);
                g.drawString(watermark, font, newW - #watermark * 12 - 20, newH - 40, brush);
            }

            // 输出文件名
            var outExt = doFormat ? targetFormat : fsys.getExtensionName(name);
            var outName = string.left(name, #name - #fsys.getExtensionName(name)) ++ "." ++ outExt;
            var outPath = outDir ++ "\\" ++ outName;

            // 保存 (gdip.bitmap.save(path) 按后缀自动定格式, jpg 第二参数为质量)
            outBmp.save(outPath, quality);

            var origSize = io.getSize(file) || 0;
            var newSize = io.getSize(outPath) || 0;
            logMsg("  已保存: " ++ outName ++ " (" ++ math.floor(newSize/1024) ++ " KB, 原 " ++ math.floor(origSize/1024) ++ " KB)");

            bmp.dispose();
            if(outBmp != bmp) outBmp.dispose();
            success = success + 1;
            }
        } catch(e){
            logMsg("  失败: " ++ tostring(e));
            failed = failed + 1;
        }

        winform.progress.setProgress(i, #files);
    }

    logMsg("处理完成! 成功: " ++ success ++ " | 失败: " ++ failed);
    main.msgbox("处理完成!\n成功: " ++ success ++ "\n失败: " ++ failed, "完成", 0x40);
    process.explore(outDir);
}

winform.show();
win.loopMessage();
