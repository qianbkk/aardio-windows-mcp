//===================================================================
// 工具11: 文件快速搜索 (Everything 风格)
// 功能: 输入关键字,实时搜索本地文件,显示路径/大小/修改时间
//===================================================================

import win.ui;
import time;
import process;

var main = win.form(text="文件搜索";right=720;bottom=500;border="thin")
main.add(
edtPath={cls="edit";text="C:\";left=10;top=10;right=710;bottom=36;edge=1;z=1};
edtQuery={cls="edit";text="";left=10;top=42;right=710;bottom=68;edge=1;font=LOGFONT(h=-14);z=2};
lblStatus={cls="static";text="输入关键字搜索文件";left=10;top=72;right=710;bottom=92;color=0x666666;transparent=1;z=3};
list={cls="listbox";text="";left=10;top=95;right=710;bottom=460;edge=1;hscroll=1;vscroll=1;z=4};
btnOpen={cls="button";text="打开";left=10;top=465;right=80;bottom=495;z=5};
btnFolder={cls="button";text="所在目录";left=90;top=465;right=180;bottom=495;z=6};
btnCopy={cls="button";text="复制路径";left=190;top=465;right=290;bottom=495;z=7};
btnRecent={cls="button";text="最近修改";left=300;top=465;right=400;bottom=495;z=8}
)

var results = {};
var lastQuery = "";

var formatSize = function(n){
    if(n < 1024) return n ++ " B";
    if(n < 1024*1024) return math.floor(n/1024) ++ " KB";
    if(n < 1024*1024*1024) return math.floor(n/1024/1024) ++ " MB";
    return string.format("%.2f GB", n/1024/1024/1024);
}

var search = function(){
    var path = string.trim(winform.edtPath.text);
    var query = string.trim(string.lower(winform.edtQuery.text));
    if(#query == 0){
        winform.list.clear();
        winform.lblStatus.text = "输入关键字搜索文件";
        return;
    }

    winform.list.clear();
    winform.lblStatus.text = "搜索中...";
    results = {};
    var startTime = time.now();
    var count = 0;

    // 通配符自动补全
    if(!string.find(query, "*") && !string.find(query, "?")){
        query = "*" ++ query ++ "*";
    }

    try{
        // fsys.enum(dir, fileMask, 回调, 是否递归) — 替代不存在的 fsys.search 扩展库
        // 回调签名: function(dir, filename, fullpath, findData), filename 为空表示目录条目
        var searchMask = query;   // 通配符 mask, 如 *.txt
        fsys.enum(path, searchMask, function(dir, filename, fullpath){
            if(!filename) return;   // 跳过目录条目
            if(count >= 500) return false;   // 达到上限停止枚举
            try{
                var info = {
                    path = fullpath;
                    name = fsys.getFileName(fullpath);
                    dir = fsys.getParentDir(fullpath);
                }
                if(fsys.isFile(fullpath)){
                    info.size = io.getSize(fullpath);
                    var ft = fsys.getTime(fullpath);
                    if(ft) info.mtime = ft.write;
                }
                table.push(results, info);
                var display = info.name;
                if(info.size){
                    display = display ++ "  (" ++ formatSize(info.size) ++ ")";
                }
                if(info.mtime){
                    display = display ++ "  - " ++ time(info.mtime, "%Y-%m-%d %H:%M");
                }
                display = display ++ "  - " ++ info.dir;
                winform.list.add(display);
                count = count + 1;
            } catch(e){}
        }, true);
    } catch(e){
        winform.lblStatus.text = "搜索出错: " ++ tostring(e);
        return;
    }

    var elapsed = time.now() - startTime;
    winform.lblStatus.text = "找到 " ++ count ++ " 个结果 - 用时 " ++ elapsed ++ " ms";
    lastQuery = query;
}

var searchTimer = null;
winform.edtQuery.onChange = function(){
    if(searchTimer) winform.clearInterval(searchTimer);
    searchTimer = winform.setInterval(300, function(){
        if(searchTimer){
            winform.clearInterval(searchTimer);
            searchTimer = null;
        }
        search();
    });
}

winform.edtPath.onChange = search;

winform.list.onDoubleClick = function(){
    var idx = winform.list.selIndex;
    if(idx && results[idx]){
        process.execute(results[idx].path);
    }
}

winform.btnOpen.oncommand = function(){
    var idx = winform.list.selIndex;
    if(idx && results[idx]){
        process.execute(results[idx].path);
    }
}

winform.btnFolder.oncommand = function(){
    var idx = winform.list.selIndex;
    if(idx && results[idx]){
        process.explore(results[idx].dir);
    }
}

winform.btnCopy.oncommand = function(){
    var idx = winform.list.selIndex;
    if(idx && results[idx]){
        import win.clip;
        win.clip.write(results[idx].path);
    }
}

winform.btnRecent.oncommand = function(){
    // 按修改时间倒序
    winform.list.clear();
    var sorted = {};
    for(i=1; #results; 1) table.push(sorted, results[i]);
    table.sort(sorted, function(a, b){
        return (a.mtime || 0) > (b.mtime || 0);
    });
    for(i=1; #sorted; 1){
        var info = sorted[i];
        var display = info.name ++ "  (" ++ formatSize(info.size || 0) ++ ")  - " ++ time(info.mtime || 0, "%Y-%m-%d %H:%M") ++ "  - " ++ info.dir;
        winform.list.add(display);
    }
}

// 全局热键 Ctrl+Shift+F
winform.reghotkey(function(){
    if(winform.visible){
        winform.hide();
    } else {
        winform.show();
        winform.setForeground();
        winform.edtQuery.setFocus();
    }
}, 0x0002 | 0x0004, 'F'#);

winform.show();
win.loopMessage();
