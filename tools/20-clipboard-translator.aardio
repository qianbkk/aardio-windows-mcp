//===================================================================
// 工具20: 剪贴板翻译
// 功能: 复制文本自动翻译,可切换中英日韩等
//===================================================================

import win.ui;
import win.clip;
import JSON;
import time;
import win.util.tray;

var dataFile = io.appData("/aardio-translator/config.json");
var config = {
    sourceLang = "auto";
    targetLang = "zh";
    api = "google";  // google | openai | minimax
    openaiKey = "";
    openaiModel = "gpt-4o-mini";
    openaiUrl = "https://api.openai.com/v1";
    lastTranslation = "";
    history = {};
}

if(fsys.isFile(dataFile)){
    try{
        var c = string.load(dataFile);
        if(c) config = JSON.parse(c);
    }
}

var saveConfig = function(){
    if(!fsys.isDir(fsys.getParentDir(dataFile))) fsys.createDir(fsys.getParentDir(dataFile));
    string.save(dataFile, JSON.stringify(config, true), false);
}

var langs = {
    {code="auto"; name="自动检测"};
    {code="zh"; name="中文"};
    {code="en"; name="英语"};
    {code="ja"; name="日语"};
    {code="ko"; name="韩语"};
    {code="fr"; name="法语"};
    {code="de"; name="德语"};
    {code="ru"; name="俄语"};
    {code="es"; name="西班牙语"};
}

var translateWithGoogle = function(text, target){
    try{
        import inet.http;
        var http = inet.http();
        var url = string.format(
            "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=%s&dt=t&q=%s",
            target,
            inet.url.encode(text)
        );
        var resp = http.get(url);
        // 解析 JSON 数组
        // resp 是 [[["translation","source",null,null,1]],null,null,null,..."en"]]
        if(resp){
            // 提取所有翻译
            var translated = "";
            try{
                var j = JSON.parse(resp);
                if(j && j[1]){
                    for(i=1; j[1][i]; 1){
                        if(j[1][i] && j[1][i][1]){
                            translated = translated ++ j[1][i][1];
                        }
                    }
                }
                // 主体翻译
                if(j && j[1] && j[1][1] && j[1][1][1]){
                    translated = j[1][1][1];
                }
            } catch(ee){
                // 简单解析失败
            }
            return translated || "[解析失败]";
        }
    } catch(e){
        return "[错误] " ++ tostring(e);
    }
    return "[无响应]";
}

var translateWithOpenAI = function(text, target){
    try{
        import web.rest;
        var ai = web.rest(config.openaiUrl);
        ai.token = config.openaiKey;
        var lang = "中文";
        for(i=1; #langs; 1){
            if(langs[i].code == target) lang = langs[i].name;
        }
        var resp, err = ai.chat.completions.post({
            model = config.openaiModel;
            messages = {
                {role="system"; content="你是一个翻译专家,只输出翻译结果,不要解释。"};
                {role="user"; content="翻译为" ++ lang ++ ":\n\n" ++ text};
            }
        });
        if(resp && resp.choices && resp.choices[1] && resp.choices[1].message){
            return resp.choices[1].message.content;
        }
        return "[错误] " ++ tostring(err);
    } catch(e){
        return "[错误] " ++ tostring(e);
    }
}

var translate = function(text){
    if(#text == 0) return;
    if(config.api == "google") return translateWithGoogle(text, config.targetLang);
    if(config.api == "openai" || config.api == "minimax") return translateWithOpenAI(text, config.targetLang);
    return "[未配置 API]";
}

var lastClipText = "";
var main = win.form(text="剪贴板翻译";right=500;bottom=420;border="thin")
main.add(
lblStatus={cls="static";text="监听剪贴板 - 复制文本自动翻译";left=10;top=10;right=490;bottom=30;color=0x666666;z=1};
toolbar={cls="bk";left=0;top=35;right=500;bottom=65;bgcolor=0xF0F0F0;z=2};
lblFrom={cls="static";text="源:";left=10;top=40;right=50;bottom=60;z=3};
cmbFrom={cls="combobox";text="";left=55;top=37;right=160;bottom=60;edge=1;z=4};
lblTo={cls="static";text="→";left=165;top=40;right=185;bottom=60;align="center";z=5};
cmbTo={cls="combobox";text="";left=190;top=37;right=290;bottom=60;edge=1;z=6};
btnSwap={cls="button";text="⇄";left=295;top=37;right=325;bottom=60;z=7};
cmbApi={cls="combobox";text="";left=330;top=37;right=490;bottom=60;edge=1;items={"google (免费)";"openai";"MiniMax"};z=8};
edtSource={cls="edit";text="";left=10;top=75;right=490;bottom=200;edge=1;hscroll=1;multiline=1;vscroll=1;z=9};
edtTarget={cls="edit";text="";left=10;top=210;right=490;bottom=335;bgcolor=0xF0F8FF;edge=1;hscroll=1;multiline=1;readonly=1;vscroll=1;z=10};
btnCopy={cls="button";text="复制译文";left=10;top=345;right=100;bottom=375;z=11};
btnReplace={cls="button";text="替换剪贴板";left=110;top=345;right=220;bottom=375;z=12};
btnHistory={cls="button";text="历史";left=230;top=345;right=300;bottom=375;z=13};
btnSettings={cls="button";text="设置";left=310;top=345;right=380;bottom=375;z=14};
status={cls="static";text="就绪";left=10;top=380;right=490;bottom=405;color=0x666666;transparent=1;z=15}
)

for(i=1; #langs; 1){
    main.cmbFrom.add(langs[i].name);
    main.cmbTo.add(langs[i].name);
}
main.cmbFrom.selIndex = 1;  // auto
main.cmbTo.selIndex = 2;  // zh

// 监听剪贴板
var checkClip = function(){
    try{
        var c = win.clip.read();
        if(c && c != lastClipText && #c > 0 && #c < 5000){
            lastClipText = c;
            main.edtSource.text = c;
            main.status.text = "检测到新内容,正在翻译...";
            thread.invoke(
                function(winform, c, config){
                    var result = translate(c);
                    winform.edtTarget.text = result;
                    winform.status.text = "完成 - 长度 " ++ #c ++ " → " ++ #result;
                    // 历史
                    if(#result > 0 && !string.startWith(result, "[")){
                        table.push(config.history, {
                            t = time.now();
                            from = config.sourceLang;
                            to = config.targetLang;
                            source = string.left(c, 200);
                            target = string.left(result, 200);
                        });
                        if(#config.history > 50) table.remove(config.history, 1);
                        saveConfig();
                    }
                },
                main, c, config
            )
        }
    } catch(e){}
}

main.setInterval(500, checkClip);

main.btnSwap.oncommand = function(){
    var fromIdx = main.cmbFrom.selIndex;
    var toIdx = main.cmbTo.selIndex;
    main.cmbFrom.selIndex = toIdx;
    main.cmbTo.selIndex = fromIdx == 1 ? 2 : 1;  // 不能 swap 到 auto
    config.sourceLang = langs[main.cmbFrom.selIndex].code;
    config.targetLang = langs[main.cmbTo.selIndex].code;
    saveConfig();
};

main.cmbFrom.oncommand = function(){
    config.sourceLang = langs[main.cmbFrom.selIndex].code;
    saveConfig();
};
main.cmbTo.oncommand = function(){
    config.targetLang = langs[main.cmbTo.selIndex].code;
    saveConfig();
};
main.cmbApi.oncommand = function(){
    var idx = main.cmbApi.selIndex;
    if(idx == 1) config.api = "google";
    else if(idx == 2) config.api = "openai";
    else if(idx == 3) config.api = "minimax";
    saveConfig();
};

main.btnCopy.oncommand = function(){
    win.clip.write(main.edtTarget.text);
    main.status.text = "已复制译文";
};
main.btnReplace.oncommand = function(){
    win.clip.write(main.edtTarget.text);
    lastClipText = main.edtTarget.text;
    main.status.text = "剪贴板已替换为译文";
};

main.btnHistory.oncommand = function(){
    var dlg = win.form(text="翻译历史";right=600;bottom=500;border="thin")
    dlg.add(
    list={cls="listbox";text="";left=10;top=10;right=590;bottom=430;edge=1;vscroll=1;z=1};
    btnCopy={cls="button";text="复制这条";left=10;top=440;right=100;bottom=470;z=2};
    btnClose={cls="button";text="关闭";left=500;top=440;right=590;bottom=470;z=3}
    )
    for(i=1; #config.history; 1){
        var h = config.history[i];
        var t = time(h.t, "%m-%d %H:%M");
        dlg.list.add(t ++ "  [" ++ h.from ++ "→" ++ h.to ++ "]  " ++ string.left(h.source, 40) ++ "...");
    }
    dlg.list.onDoubleClick = function(){
        var idx = dlg.list.selIndex;
        if(idx && config.history[idx]){
            main.edtSource.text = config.history[idx].source;
            main.edtTarget.text = config.history[idx].target;
            dlg.close();
        }
    }
    dlg.btnCopy.oncommand = function(){
        var idx = dlg.list.selIndex;
        if(idx && config.history[idx]){
            win.clip.write(config.history[idx].target);
        }
    }
    dlg.btnClose.oncommand = function(){ dlg.close(); }
    dlg.show();
};

main.btnSettings.oncommand = function(){
    var dlg = win.form(text="设置";right=400;bottom=300;border="thin")
    dlg.add(
    lbl1={cls="static";text="API Key:";left=10;top=15;right=80;bottom=35;z=1};
    edtKey={cls="edit";text=config.openaiKey;left=90;top=10;right=380;bottom=35;edge=1;z=2};
    lbl2={cls="static";text="URL:";left=10;top=50;right=80;bottom=70;z=3};
    edtUrl={cls="edit";text=config.openaiUrl;left=90;top=45;right=380;bottom=70;edge=1;z=4};
    lbl3={cls="static";text="Model:";left=10;top=85;right=80;bottom=105;z=5};
    edtModel={cls="edit";text=config.openaiModel;left=90;top=80;right=380;bottom=105;edge=1;z=6};
    lbl4={cls="static";text="提示: Google API 免费但需联网; OpenAI/MiniMax 需 Key";left=10;top=120;right=380;bottom=145;color=0x999999;transparent=1;z=7};
    btnOK={cls="button";text="保存";left=100;top=240;right=180;bottom=270;z=8};
    btnCancel={cls="button";text="取消";left=200;top=240;right=280;bottom=270;z=9}
    )
    dlg.btnOK.oncommand = function(){
        config.openaiKey = dlg.edtKey.text;
        config.openaiUrl = dlg.edtUrl.text;
        config.openaiModel = dlg.edtModel.text;
        saveConfig();
        dlg.close();
    }
    dlg.btnCancel.oncommand = function(){ dlg.close(); }
    dlg.show();
};

// 托盘
import win.util.tray;
import fsys;
var tray = win.util.tray(main, {tooltip="剪贴板翻译"})

tray.message = function(wParam, lParam){
    if(lParam == 0x205){
        win.setForeground(main.hwnd, true);
        main.popmenu = win.ui.popmenu(main);
        main.popmenu.add("显示主窗口", function(){
            main.show();
            main.setForeground();
        });
        main.popmenu.add();
        main.popmenu.add("退出", function(){
            saveConfig();
            main.close();
        });
        main.popmenu.popup();
        main.popmenu.close();
    } else if(lParam == 0x202){
        main.show();
        main.setForeground();
    }
}

main.onClose = function(){
    saveConfig();
    main.hide();
    return true;
}

main.show();
win.loopMessage();
