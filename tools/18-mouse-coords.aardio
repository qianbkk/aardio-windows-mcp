//===================================================================
// 工具18: 鼠标坐标实时显示
// 功能: 屏幕角落小窗口,实时显示鼠标坐标 + RGB
//===================================================================

import win.ui;
import com.picture;
import gdip;
import time;
import win.util.tray;


// 取屏幕像素颜色 (win.colorPick 不存在, 全屏截图 + gdip.bitmap.getPixel)
var pickPixel = function(x, y){
    var pic = com.picture.snap();
    var bmp = gdip.bitmap(pic);
    var clr = bmp.getPixel(x, y);
    var r = clr & 0xFF;
    var g = (clr >> 8) & 0xFF;
    var b = (clr >> 16) & 0xFF;
    return r, g, b;
}

var int2hex = function(n){
    var hex = "";
    var digits = "0123456789ABCDEF";
    for(i=1; 2; 1){
        hex = string.slice(digits, (n % 16) + 1, (n % 16) + 1) ++ hex;
        n = math.floor(n / 16);
    }
    return hex;
}

// 桌面画十字
var overlay = win.form(text="";right=0;bottom=0;border="none")
overlay.mode = "popup"
overlay.exmode = "toolwindow"
overlay.transparent = 1  // 完全透明
var sw, sh = win.getScreen();
overlay.setPos(0, 0, sw, sh)

var lbl = win.form(text="";right=180;bottom=80;border="thin";mode="popup")
lbl.setPos(20, 20)
lbl.bgcolor = 0xFF000000
lbl.transparent = 200
lbl.add(
lbl1={cls="static";text="X: 0    Y: 0";left=0;top=0;right=180;bottom=30;align="center";color=0xFFFFFFFF;font=LOGFONT(h=-15;weight=700);z=1};
lbl2={cls="static";text="#000000";left=0;top=30;right=180;bottom=55;align="center";color=0xFFCCCCCC;font=LOGFONT(h=-12);z=2};
lbl3={cls="static";text="RGB(0,0,0)";left=0;top=55;right=180;bottom=80;align="center";color=0xFF999999;font=LOGFONT(h=-11);z=3}
)

var update = function(){
    var x, y = win.getCursorPos();
    var r, g, b = pickPixel(x, y);
    lbl.lbl1.text = "X: " ++ x ++ "    Y: " ++ y;
    lbl.lbl2.text = "#" ++ int2hex(r) ++ int2hex(g) ++ int2hex(b);
    lbl.lbl3.text = "RGB(" ++ r ++ ", " ++ g ++ ", " ++ b ++ ")";
    lbl.bgcolor = 0xFF000000 | (r * 0x10000) | (g * 0x100) | b;
}

lbl.setInterval(50, update);
overlay.setInterval(50, function(){
    // 画十字线
    var x, y = win.getCursorPos();
})

// 拖动 lbl 位置
var dragging = false;
var dragX, dragY;
lbl.onMouseDown = function(wParam, lParam){
    dragging = true;
    dragX, dragY = lParam;
    return true;
}
lbl.onMouseMove = function(wParam, lParam){
    if(dragging){
        var x, y = win.getCursorPos();
        lbl.setPos(x - dragX, y - dragY)
    }
}
lbl.onMouseUp = function(){
    dragging = false;
}

// 双击隐藏
lbl.onDoubleClick = function(){
    lbl.hide();
    overlay.close();
}

// 右键菜单
import win.ui.menu;
lbl.popmenu = win.ui.popmenu(lbl)
lbl.popmenu.add("切换显示位置", function(){
    var x, y = win.getCursorPos();
    var sw, sh = win.getScreen();
    if(x < sw/2 && y < sh/2){
        lbl.setPos(sw - 200, sh - 100);
    } else if(x >= sw/2 && y < sh/2){
        lbl.setPos(20, sh - 100);
    } else if(x < sw/2 && y >= sh/2){
        lbl.setPos(sw - 200, 20);
    } else {
        lbl.setPos(20, 20);
    }
})
lbl.popmenu.add("隐藏 (双击也可)", function(){
    lbl.hide();
    overlay.close();
})
lbl.popmenu.add("显示", function(){
    lbl.show();
    overlay.show();
})

lbl.show();
overlay.show();

// 托盘唤起
import win.util.tray;
var tray = win.util.tray(lbl, {tooltip="鼠标坐标显示器"})
tray.message = function(wParam, lParam){
    if(lParam == 0x202){
        if(lbl.visible){
            lbl.hide();
            overlay.hide();
        } else {
            lbl.show();
            overlay.show();
        }
    } else if(lParam == 0x205){
        win.setForeground(lbl.hwnd, true);
        lbl.popmenu.popup();
        lbl.popmenu.close();
    }
}

win.loopMessage();
