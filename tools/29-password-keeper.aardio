//===================================================================
// 工具29: 简易密码管理器
// 功能: AES 加密本地存储,主密码保护,自动生成强密码
//===================================================================

import win.ui;
import crypt;
import JSON;
import fsys;
import time;
import win.util.tray;
import win.clip;

var dataFile = io.appData("/aardio-pw-keeper/vault.dat");
var configFile = io.appData("/aardio-pw-keeper/config.json");
var masterHash = null;
var entries = {};
var config = {
    lastUnlock = 0;
    autoLock = 5;  // 分钟
}

if(fsys.isFile(configFile)){
    try{
        var c = string.load(configFile);
        if(c) config = JSON.parse(c);
    }
}

var saveConfig = function(){
    if(!fsys.isDir(fsys.getParentDir(configFile))) fsys.createDir(fsys.getParentDir(configFile));
    string.save(configFile, JSON.stringify(config, true), false);
}

var hashPassword = function(pwd){
    // 简单 hash (生产环境用 bcrypt/scrypt)
    var hash = crypt.md5(pwd);
    for(i=1; 1000; 1){
        hash = crypt.md5(hash ++ pwd);
    }
    return hash;
}

var encryptData = function(data, pwd){
    var aes = crypt.aes(pwd);
    return aes.encrypt(data);
}

var decryptData = function(data, pwd){
    var aes = crypt.aes(pwd);
    return aes.decrypt(data);
}

var saveEntries = function(){
    if(!masterHash) return;
    try{
        if(!fsys.isDir(fsys.getParentDir(dataFile))) fsys.createDir(fsys.getParentDir(dataFile));
        var json = JSON.stringify(entries, true);
        var encrypted = encryptData(json, masterHash);
        string.save(dataFile, encrypted, false);
    } catch(e){
        main.msgbox("保存失败: " ++ tostring(e), "错误", 0x10);
    }
}

var loadEntries = function(){
    if(!masterHash) return false;
    if(!fsys.isFile(dataFile)){
        entries = {};
        return true;
    }
    try{
        var encrypted = string.load(dataFile);
        var json = decryptData(encrypted, masterHash);
        entries = JSON.parse(json);
        return true;
    } catch(e){
        return false;
    }
}

// 登录窗口
var login = function(){
    if(fsys.isFile(dataFile)){
        // 已存在 vault,验证主密码
        var dlg = win.form(text="解锁密码库";right=400;bottom=200;border="thin";mode="popup")
        dlg.add(
        lbl={cls="static";text="请输入主密码:";left=10;top=15;right=380;bottom=35;z=1};
        edt={cls="edit";text="";left=10;top=40;right=380;bottom=70;edge=1;password=1;z=2};
        btn={cls="button";text="解锁";left=100;top=90;right=200;bottom=120;z=3};
        btnReset={cls="button";text="忘记密码?";left=210;top=90;right=300;bottom=120;z=4}
        )
        dlg.btn.oncommand = function(){
            var pwd = dlg.edt.text;
            if(#pwd == 0) return;
            var hash = hashPassword(pwd);
            try{
                var encrypted = string.load(dataFile);
                var json = decryptData(encrypted, hash);
                entries = JSON.parse(json);
                masterHash = hash;
                dlg.close();
            } catch(e){
                dlg.edt.text = "";
                dlg.msgbox("密码错误!", "错误", 0x10);
            }
        }
        dlg.edt.onOk = dlg.btn.oncommand;
        dlg.btnReset.oncommand = function(){
            if(dlg.msgbox("忘记密码将无法恢复任何数据!\n确定重置吗?", "警告", 0x24) == 6){
                if(fsys.isFile(dataFile)) io.remove(dataFile);
                masterHash = null;
                entries = {};
                dlg.close();
                firstTime();
            }
        }
        dlg.show();
    } else {
        firstTime();
    }
}

var firstTime = function(){
    var dlg = win.form(text="创建主密码";right=400;bottom=250;border="thin";mode="popup")
    dlg.add(
    lbl1={cls="static";text="创建主密码 (>= 6 位):";left=10;top=15;right=380;bottom=35;z=1};
    edt1={cls="edit";text="";left=10;top=40;right=380;bottom=70;edge=1;password=1;z=2};
    lbl2={cls="static";text="确认主密码:";left=10;top=85;right=380;bottom=105;z=3};
    edt2={cls="edit";text="";left=10;top=110;right=380;bottom=140;edge=1;password=1;z=4};
    lbl3={cls="static";text="⚠️ 密码遗忘将无法恢复,建议妥善保管!";left=10;top=155;right=380;bottom=175;color=0xCC0000;z=5};
    btn={cls="button";text="创建";left=140;top=190;right=240;bottom=220;z=6}
    )
    dlg.btn.oncommand = function(){
        var p1 = dlg.edt1.text;
        var p2 = dlg.edt2.text;
        if(#p1 < 6){
            dlg.msgbox("密码至少 6 位", "提示", 0x40);
            return;
        }
        if(p1 != p2){
            dlg.msgbox("两次输入不一致", "提示", 0x40);
            return;
        }
        masterHash = hashPassword(p1);
        entries = {};
        saveEntries();
        dlg.close();
    }
    dlg.show();
}

var main = win.form(text="密码管理器 (已加密)";right=750;bottom=550;border="thin")
main.add(
toolbar={cls="bk";left=0;top=0;right=750;bottom=40;bgcolor=0xF0F0F0;z=1};
edtSearch={cls="edit";text="";left=10;top=8;right=300;bottom=32;edge=1;z=2};
btnAdd={cls="button";text="+ 添加";left=305;top=8;right=395;bottom=32;z=3};
btnGen={cls="button";text="生成强密码";left=400;top=8;right=500;bottom=32;z=4};
btnLock={cls="button";text="🔒 锁定";left=505;top=8;right=590;bottom=32;z=5};
btnChange={cls="button";text="改主密码";left=595;top=8;right=740;bottom=32;z=6};

list={cls="listview";left=10;top=50;right=740;bottom=350;edge=1;fullRow=1;grid=1;vscroll=1;z=7};
list.insertColumn("标题", 180);
list.insertColumn("用户名", 150);
list.insertColumn("密码", 100);
list.insertColumn("网址", 200);
list.insertColumn("备注", 100);

detail={cls="bk";left=0;top=355;right=750;bottom=400;bgcolor=0xF0F0F0;z=8};
lblDetail={cls="static";text="选中查看详情";left=10;top=360;right=300;bottom=380;color=0x666666;z=9};
btnCopyUser={cls="button";text="复制用户名";left=10;top=380;right=110;bottom=400;z=10};
btnCopyPass={cls="button";text="复制密码";left=120;top=380;right=220;bottom=400;z=11};
btnCopyUrl={cls="button";text="打开网址";left=230;top=380;right=330;bottom=400;z=12};
btnEdit={cls="button";text="编辑";left=340;top=380;right=420;bottom=400;z=13};
btnDel={cls="button";text="删除";left=430;top=380;right=510;bottom=400;z=14};

status={cls="static";text="就绪";left=10;top=415;right=740;bottom=540;color=0x666666;transparent=1;z=15}
)

var autoLockTimer = null;
var resetAutoLock = function(){
    if(autoLockTimer) main.clearTimeout(autoLockTimer);
    autoLockTimer = main.setTimeout(function(){
        main.hide();
        masterHash = null;
        entries = {};
        login();
    }, config.autoLock * 60 * 1000);
}

var refreshList = function(){
    main.list.clear();
    var query = string.lower(main.edtSearch.text);
    for(i=1; #entries; 1){
        var e = entries[i];
        if(#query > 0){
            var searchText = string.lower(e.title) ++ " " ++ string.lower(e.username) ++ " " ++ string.lower(e.url || "");
            if(!string.find(searchText, query)) continue;
        }
        main.list.addItem({
            e.title;
            e.username;
            "••••••";
            e.url || "";
            e.note || "";
        });
    }
}

var addOrEdit = function(existing, idx){
    var dlg = win.form(text=(existing ? "编辑" : "添加") ++ " 密码";right=400;bottom=350;border="thin")
    dlg.add(
    lbl1={cls="static";text="标题:";left=10;top=15;right=80;bottom=35;z=1};
    edt1={cls="edit";text=(existing && existing.title) || "";left=90;top=10;right=380;bottom=35;edge=1;z=2};
    lbl2={cls="static";text="用户名:";left=10;top=50;right=80;bottom=70;z=3};
    edt2={cls="edit";text=(existing && existing.username) || "";left=90;top=45;right=380;bottom=70;edge=1;z=4};
    lbl3={cls="static";text="密码:";left=10;top=85;right=80;bottom=105;z=5};
    edt3={cls="edit";text=(existing && existing.password) || "";left=90;top=80;right=300;bottom=105;edge=1;password=1;z=6};
    btnShow={cls="button";text="👁";left=305;top=80;right=340;bottom=105;z=7};
    btnGen={cls="button";text="生成";left=345;top=80;right=380;bottom=105;z=8};
    lbl4={cls="static";text="网址:";left=10;top=120;right=80;bottom=140;z=9};
    edt4={cls="edit";text=(existing && existing.url) || "";left=90;top=115;right=380;bottom=140;edge=1;z=10};
    lbl5={cls="static";text="备注:";left=10;top=155;right=80;bottom=175;z=11};
    edt5={cls="edit";text=(existing && existing.note) || "";left=90;top=150;right=380;bottom=200;edge=1;multiline=1;z=12};
    btnOK={cls="button";text="保存";left=120;top=240;right=200;bottom=270;z=13};
    btnCancel={cls="button";text="取消";left=210;top=240;right=290;bottom=270;z=14}
    )
    var showing = false;
    dlg.btnShow.oncommand = function(){
        showing = !showing;
        dlg.edt3.password = !showing;
    }
    dlg.btnGen.oncommand = function(){
        // 生成强密码
        var chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*";
        var pwd = "";
        for(i=1; 20; 1){
            var idx = math.random(1, #chars);
            pwd = pwd ++ string.slice(chars, idx, idx);
        }
        dlg.edt3.text = pwd;
        dlg.edt3.password = false;
        showing = true;
    }
    dlg.btnOK.oncommand = function(){
        var entry = {
            title = dlg.edt1.text;
            username = dlg.edt2.text;
            password = dlg.edt3.text;
            url = dlg.edt4.text;
            note = dlg.edt5.text;
        };
        if(idx){
            entries[idx] = entry;
        } else {
            table.push(entries, entry);
        }
        saveEntries();
        refreshList();
        dlg.close();
        resetAutoLock();
    }
    dlg.btnCancel.oncommand = function(){ dlg.close(); }
    dlg.show();
}

main.btnAdd.oncommand = function(){
    addOrEdit(null, null);
    resetAutoLock();
}

main.list.onDoubleClick = function(){
    var idx = main.list.selIndex;
    if(idx && entries[idx]){
        addOrEdit(entries[idx], idx);
    }
}

main.btnEdit.oncommand = function(){
    var idx = main.list.selIndex;
    if(idx && entries[idx]) addOrEdit(entries[idx], idx);
}

main.btnDel.oncommand = function(){
    var idx = main.list.selIndex;
    if(!idx) return;
    if(main.msgbox("删除 '" ++ entries[idx].title ++ "'?", "确认", 0x24) == 6){
        table.remove(entries, idx);
        saveEntries();
        refreshList();
    }
}

main.btnCopyUser.oncommand = function(){
    var idx = main.list.selIndex;
    if(idx && entries[idx]){
        win.clip.write(entries[idx].username);
        main.status.text = "已复制用户名 - 30 秒后清空剪贴板";
        main.setTimeout(function(){
            win.clip.write("");
        }, 30000);
    }
}

main.btnCopyPass.oncommand = function(){
    var idx = main.list.selIndex;
    if(idx && entries[idx]){
        win.clip.write(entries[idx].password);
        main.status.text = "已复制密码 - 30 秒后清空剪贴板";
        main.setTimeout(function(){
            win.clip.write("");
        }, 30000);
    }
}

main.btnCopyUrl.oncommand = function(){
    var idx = main.list.selIndex;
    if(idx && entries[idx] && entries[idx].url){
        process.execute(entries[idx].url);
    }
}

main.btnLock.oncommand = function(){
    masterHash = null;
    entries = {};
    main.hide();
    login();
}

main.btnChange.oncommand = function(){
    var dlg = win.form(text="修改主密码";right=400;bottom=250;border="thin")
    dlg.add(
    lbl1={cls="static";text="当前密码:";left=10;top=15;right=380;bottom=35;z=1};
    edt1={cls="edit";text="";left=10;top=40;right=380;bottom=70;edge=1;password=1;z=2};
    lbl2={cls="static";text="新密码:";left=10;top=85;right=380;bottom=105;z=3};
    edt2={cls="edit";text="";left=10;top=110;right=380;bottom=140;edge=1;password=1;z=4};
    lbl3={cls="static";text="确认新密码:";left=10;top=155;right=380;bottom=175;z=5};
    edt3={cls="edit";text="";left=10;top=180;right=380;bottom=210;edge=1;password=1;z=6};
    btn={cls="button";text="修改";left=140;top=225;right=240;bottom=255;z=7}
    )
    dlg.btn.oncommand = function(){
        var current = dlg.edt1.text;
        var new1 = dlg.edt2.text;
        var new2 = dlg.edt3.text;
        if(hashPassword(current) != masterHash){
            dlg.msgbox("当前密码错误", "错误", 0x10);
            return;
        }
        if(#new1 < 6){
            dlg.msgbox("新密码至少 6 位", "提示", 0x40);
            return;
        }
        if(new1 != new2){
            dlg.msgbox("两次新密码不一致", "提示", 0x40);
            return;
        }
        var newHash = hashPassword(new1);
        // 用新密码重新加密
        var json = JSON.stringify(entries, true);
        var oldEncrypted = string.load(dataFile);
        try{
            var data = decryptData(oldEncrypted, masterHash);
            var newEncrypted = encryptData(data, newHash);
            string.save(dataFile, newEncrypted, false);
            masterHash = newHash;
            dlg.msgbox("已修改", "完成", 0x40);
            dlg.close();
        } catch(e){
            dlg.msgbox("修改失败: " ++ tostring(e), "错误", 0x10);
        }
    }
    dlg.show();
}

main.btnGen.oncommand = function(){
    addOrEdit(null, null);
    // 自动打开后会显示在 dlg
    // 这里简化
}

main.edtSearch.onChange = refreshList;

main.onClose = function(){
    main.hide();
    return true;
}

// 启动
login();
if(masterHash){
    refreshList();
    main.show();
}
win.loopMessage();
