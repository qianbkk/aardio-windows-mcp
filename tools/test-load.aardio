console.log("Test 7: read clipboard");
var c = win.clip.read();
console.log("OK: clipboard = " ++ (c ? tostring(c) : "null") ++ " (length " ++ (c ? #c : 0) ++ ")");

console.log("Test 8: write then read clipboard");
win.clip.write("hello aardio test " ++ time.now());
var c2 = win.clip.read();
console.log("OK: clipboard = " ++ tostring(c2));

console.log("All imports and clipboard tests passed!");
console.pause();
