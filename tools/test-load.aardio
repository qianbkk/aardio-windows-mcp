import win.clip;
console.log("OK: win.clip loaded");

console.log("Test 2: import win.clip.bitmap");
import win.clip.bitmap;
console.log("OK: win.clip.bitmap loaded");

console.log("Test 3: import wsock.tcp.simpleHttpServer");
import wsock.tcp.simpleHttpServer;
console.log("OK: wsock.tcp.simpleHttpServer loaded");

console.log("Test 4: import JSON");
import JSON;
console.log("OK: JSON loaded");

console.log("Test 5: import process");
import process;
console.log("OK: process loaded");

console.log("Test 6: import fsys");
import fsys;
